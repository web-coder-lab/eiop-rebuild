NODE_ENV=production
PORT=3001
TRUST_PROXY=true
# Empty CORS = same-origin only. Never use * in production.
CORS_ORIGIN=
CLIENT_DIST=../web/dist

# Application data + media. Server-side only.
PRIVATE_API_BASE_URL=
PRIVATE_API_KEY=
PRIVATE_API_TIMEOUT_MS=15000
PRIVATE_API_UPLOAD_MAX_MB=100

# Financial records + assigned storage only.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Payments. Webhook secret stays server-side.
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_GATEWAY_TIMEOUT_MS=15000

# Google login (Part 4). Client ID is public; client secret is server-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Session signing (Part 4). Generate a long random value. Never commit the real one.
SESSION_SECRET=

MAX_STREAM_STORAGE_HOURS=6
LOG_LEVEL=info

# Gmail SMTP (16-char App Password). Do not commit the real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
DATA_DIR=./data

APK_PATH=
APK_VERSION=
